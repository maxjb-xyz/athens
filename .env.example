# Athens — environment variables

# LLM provider: "mock" (offline demo) or "openai" (any OpenAI-compatible endpoint)
ATHENS_LLM_PROVIDER=mock

# OpenAI-compatible base URL. Ollama exposes /v1; OpenAI uses https://api.openai.com/v1
ATHENS_LLM_BASE_URL=http://localhost:11434/v1

# Model name
ATHENS_LLM_MODEL=llama3.1

# API key (leave empty for local Ollama)
ATHENS_LLM_API_KEY=
